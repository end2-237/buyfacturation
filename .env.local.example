# Supabase — Récupérer dans Settings > API sur supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJxxxx  # clé service_role (Settings > API)

# Email SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tonmail@gmail.com
SMTP_PASS=mot_de_passe_application
SMTP_FROM=BUYTICLE ETS <noreply@buyticle.com>

# PawaPay (mobile money) — récupérer dans le dashboard PawaPay
PAWAPAY_API_TOKEN=xxxx
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io   # prod : https://api.pawapay.io
PAWAPAY_WEBHOOK_SECRET=                            # si fourni pour vérifier la signature
PAWAPAY_CORRESPONDENT_MTN=MTN_MOMO_CMR             # code opérateur (à confirmer)
PAWAPAY_CORRESPONDENT_ORANGE=ORANGE_CMR
PAYMENT_DEFAULT_PROVIDER=pawapay
